# PostgreSQL used by docker-compose.yml and collector-service
POSTGRES_DB=poe_pricer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Official Path of Exile confidential OAuth client with service:psapi
POE_CLIENT_ID=
POE_CLIENT_SECRET=
POE_CONTACT=
POE_LEAGUE=Mirage
POE_COLLECTOR_ENABLED=false

# One-shot Trade dataset importer
POE_TRADE_DATASET_ENABLED=false
POE_TRADE_LEAGUE=Mirage
POE_TRADE_DATASET_RUN_KEY=
POE_TRADE_DATASET_CATEGORY=weapon.bow
POE_TRADE_DATASET_PRICE_CURRENCY=divine
POE_TRADE_DATASET_MINIMUM_PRICE=1
POE_TRADE_DATASET_MAXIMUM_PRICE=400
POE_TRADE_DATASET_TARGET_SIZE=3000
POE_TRADE_DATASET_SEARCH_REQUEST_DELAY=11s
POE_TRADE_DATASET_FETCH_REQUEST_DELAY=5s
POE_USER_AGENT=

# ML training and local Docker permissions
ML_TRAINING_RUN_KEYS=mirage-rare-bows-20260714-v2,mirage-rare-bows-20260714-v6
ML_HOLDOUT_RUN_KEY=mirage-rare-bows-20260714-v6
ML_TRAINING_MAXIMUM_PRICE=400
LOCAL_UID=1000
LOCAL_GID=1000
